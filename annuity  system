   ========================================================= */
function exportJSON(){
  const blob=new Blob([JSON.stringify({patents:state.patents},null,2)],{type:'application/json'});
  const url=URL.createObjectURL(blob); const a=document.createElement('a');
  a.href=url; a.download='专利年费数据_'+fmtDate(new Date())+'.json'; a.click();
  URL.revokeObjectURL(url);
}
function importJSON(file){
  const reader=new FileReader();
  reader.onload=async e=>{
    try{
      const data=JSON.parse(e.target.result);
      const list=Array.isArray(data)?data:(data.patents||[]);
      if(!Array.isArray(list)) throw new Error('格式不正确');
      let ok=0;
      for(const item of list){
        const row={
          id:item.id||('P'+Date.now()+Math.random().toString(36).slice(2,7)),
          user_id:state.user.id,
          name:item.name||'', app_no:item.appNo||item.app_no||'',
          app_date:item.appDate||item.app_date||'', grant_date:item.grantDate||item.grant_date||'',
          type:item.type||'发明', client:item.client||'', reduction:Number(item.reduction)||0,
          status:item.status||'有效', archived:!!item.archived, archived_at:item.archivedAt||'',
          contact:item.contact||'', phone:item.phone||'', notes:item.notes||'',
          paid_years:item.paidYears||item.paid_years||[]
        };
        const { error } = await supabase.from('patents').upsert(row,{onConflict:'id'});
        if(!error) ok++;
      }
      await loadPatents(); renderAll();
      alert(`导入完成：成功 ${ok} 条 / 共 ${list.length} 条`);
    }catch(err){ alert('导入失败：'+err.message); }
  };
  reader.readAsText(file);
}
function exportCSV(filename,header,rows){
  const lines=[header].concat(rows);
  const csv=lines.map(r=>r.map(c=>{
    const s=String(c==null?'':c);
    return /[",\n]/.test(s)?'"'+s.replace(/"/g,'""')+'"':s;
  }).join(',')).join('\r\n');
  const blob=new Blob(['\ufeff'+csv],{type:'text/csv;charset=utf-8'});
  const url=URL.createObjectURL(blob); const a=document.createElement('a');
  a.href=url; a.download=filename; a.click(); URL.revokeObjectURL(url);
}

/* =========================================================
   14. 事件绑定
   ========================================================= */
function bindEvents(){
  document.getElementById('authSubmit').addEventListener('click',handleAuth);
  document.getElementById('authToggleLink').addEventListener('click',()=>{
    setAuthMode(authMode==='login'?'signup':'login');
  });
  document.getElementById('authPassword').addEventListener('keydown',e=>{
    if(e.key==='Enter') handleAuth();
  });
  document.getElementById('btnLogout').addEventListener('click',logout);

  document.querySelectorAll('.tab').forEach(tab=>tab.addEventListener('click',()=>{
    document.querySelectorAll('.tab').forEach(t=>t.classList.remove('active'));
    document.querySelectorAll('.panel').forEach(p=>p.classList.remove('active'));
    tab.classList.add('active');
    document.getElementById('panel-'+tab.dataset.tab).classList.add('active');
    const t=tab.dataset.tab;
    if(t==='dashboard') renderDashboard();
    if(t==='ledger') renderLedger();
    if(t==='schedule') renderSchedule();
    if(t==='report') renderReport();
  }));

  document.getElementById('btnAdd').addEventListener('click',()=>openPatentModal(null));
  document.getElementById('btnExportAll').addEventListener('click',exportJSON);
  document.getElementById('btnImport').addEventListener('click',()=>document.getElementById('fileInput').click());
  document.getElementById('fileInput').addEventListener('change',e=>{
    if(e.target.files[0]) importJSON(e.target.files[0]); e.target.value='';
  });

  document.getElementById('alertHorizon').addEventListener('change',e=>{
    state.settings.alertHorizon=Number(e.target.value); renderDashboard();
  });

  document.querySelectorAll('#ledgerScope .seg-btn').forEach(btn=>btn.addEventListener('click',()=>{
    document.querySelectorAll('#ledgerScope .seg-btn').forEach(b=>b.classList.remove('active'));
    btn.classList.add('active'); ledgerScope=btn.dataset.scope;
    clearSelection(); renderLedger();
  }));

  ['ledgerClient','ledgerType','ledgerReduction','ledgerStatus','ledgerUrgency','ledgerAppFrom','ledgerAppTo']
    .forEach(id=>document.getElementById(id).addEventListener('change',renderLedger));
  document.getElementById('ledgerSearch').addEventListener('input',renderLedger);
  document.getElementById('btnResetFilters').addEventListener('click',()=>{
    document.getElementById('ledgerSearch').value='';
    ['ledgerClient','ledgerType','ledgerReduction','ledgerStatus','ledgerUrgency','ledgerAppFrom','ledgerAppTo']
      .forEach(id=>document.getElementById(id).value='');
    clearSelection(); renderLedger();
  });

  document.getElementById('checkAll').addEventListener('change',e=>{
    const checked=e.target.checked;
    document.querySelectorAll('#ledgerBody .row-check').forEach(cb=>{
      cb.checked=checked;
      if(checked) selectedIds.add(cb.dataset.id); else selectedIds.delete(cb.dataset.id);
      cb.closest('tr').classList.toggle('selected',checked);
    });
    updateBulkBar();
  });

  document.getElementById('bulkArchive').addEventListener('click',bulkArchive);
  document.getElementById('bulkRestore').addEventListener('click',bulkRestore);
  document.getElementById('bulkSetStatus').addEventListener('click',bulkSetStatus);
  document.getElementById('bulkExport').addEventListener('click',bulkExport);
  document.getElementById('bulkClear').addEventListener('click',()=>{
    clearSelection();
    document.querySelectorAll('#ledgerBody tr').forEach(tr=>tr.classList.remove('selected'));
    document.querySelectorAll('#ledgerBody .row-check').forEach(cb=>cb.checked=false);
    updateBulkBar();
  });

  document.getElementById('scheduleRange').addEventListener('change',renderSchedule);
  document.getElementById('scheduleClient').addEventListener('change',renderSchedule);
  document.getElementById('btnExportSchedule').addEventListener('click',()=>{
    const header=['截止日','剩余天数','客户','专利名称','申请号','类型','年度','官费','减免','应缴','滞纳金','合计'];
    const rows=scheduleCache.map(it=>[it.dueDate,it.daysLeft,it.patent.client,it.patent.name,
      it.patent.appNo,it.patent.type,'第'+it.year+'年',it.baseFee,
      it.reduction>0?it.reduction+'%':'0',it.fee,it.lateFee,it.total]);
    exportCSV('缴费计划_'+fmtDate(new Date())+'.csv',header,rows);
  });

  document.getElementById('reportYear').addEventListener('change',renderReport);
  document.getElementById('reportClient').addEventListener('change',renderReport);
  document.getElementById('btnExportReport').addEventListener('click',()=>{
    const today=startOfDay(new Date());
    const year=Number(document.getElementById('reportYear').value);
    const fClient=document.getElementById('reportClient').value;
    let items=[]; monitored().forEach(p=>{ items=items.concat(getUnpaidItems(p,today)); });
    if(fClient) items=items.filter(it=>it.patent.client===fClient);
    items=items.filter(it=>{ const d=parseDate(it.dueDate); return d&&d.getFullYear()===year; })
      .sort((a,b)=>parseDate(a.dueDate)-parseDate(b.dueDate));
    const header=['季度','截止日','客户','专利名称','申请号','类型','年度','官费','减免','应缴','滞纳金','合计'];
    const rows=items.map(it=>['Q'+(Math.floor(parseDate(it.dueDate).getMonth()/3)+1),
      it.dueDate,it.patent.client,it.patent.name,it.patent.appNo,it.patent.type,
      '第'+it.year+'年',it.baseFee,it.reduction>0?it.reduction+'%':'0',
      it.fee,it.lateFee,it.total]);
    exportCSV('季度报表_'+year+'.csv',header,rows);
  });

  document.querySelectorAll('[data-close]').forEach(b=>b.addEventListener('click',()=>{
    b.closest('.overlay').classList.remove('show');
  }));
  document.querySelectorAll('.overlay').forEach(ov=>ov.addEventListener('click',e=>{
    if(e.target===ov) ov.classList.remove('show');
  }));
  document.addEventListener('keydown',e=>{
    if(e.key==='Escape') document.querySelectorAll('.overlay.show').forEach(o=>o.classList.remove('show'));
  });
  document.getElementById('btnSavePatent').addEventListener('click',savePatent);
}

/* =========================================================
   15. 初始化
   ========================================================= */
function renderAll(){
  renderClientOptions();
  renderDashboard();
  renderLedger();
  renderSchedule();
  renderReport();
}

(async function init(){
  bindEvents();
  setAuthMode('login');

  const { data: { session } } = await supabase.auth.getSession();
  if(session && session.user){
    showApp(session.user);
    await loadPatents();
    renderAll();
  }

  supabase.auth.onAuthStateChange(async (event, session) => {
    if(event==='SIGNED_IN' && session && session.user){
      showApp(session.user);
      await loadPatents();
      renderAll();
    }
    if(event==='SIGNED_OUT'){
      state.user=null; state.patents=[];
      document.getElementById('app').classList.remove('ready');
      document.getElementById('authScreen').style.display='flex';
      document.getElementById('authPassword').value='';
      setAuthMode('login');
    }
  });
})();
</script>

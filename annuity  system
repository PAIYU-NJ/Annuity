<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>专利年费管理系统</title>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
:root{
  --bg:#f1f5f9; --card:#fff; --border:#e2e8f0; --text:#0f172a; --text2:#64748b;
  --primary:#2563eb; --primary-d:#1d4ed8; --danger:#dc2626; --danger-bg:#fef2f2;
  --warn:#d97706; --warn-bg:#fffbeb; --ok:#16a34a; --ok-bg:#f0fdf4;
  --info:#0891b2; --info-bg:#ecfeff; --radius:12px;
  --stripe:#fafbfc; --hover:#f1f5f9; --sel:#eff6ff;
}
*{box-sizing:border-box;margin:0;padding:0}
body{
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Microsoft YaHei",sans-serif;
  background:var(--bg);color:var(--text);font-size:14px;line-height:1.6;-webkit-font-smoothing:antialiased;
}
button{font-family:inherit;cursor:pointer;border:none;background:none;font-size:inherit}
input,select,textarea{font-family:inherit;font-size:inherit}
input[type=checkbox]{width:15px;height:15px;cursor:pointer;accent-color:var(--primary)}

/* ===== 登录界面 ===== */
#authScreen{position:fixed;inset:0;background:linear-gradient(135deg,#1e3a8a,#2563eb);
  display:flex;align-items:center;justify-content:center;z-index:200;padding:20px}
.auth-card{background:#fff;border-radius:18px;padding:36px 32px;width:100%;max-width:400px;
  box-shadow:0 24px 60px rgba(0,0,0,.3)}
.auth-card .logo{width:56px;height:56px;border-radius:16px;background:linear-gradient(135deg,#2563eb,#1d4ed8);
  display:flex;align-items:center;justify-content:center;font-size:26px;color:#fff;margin:0 auto 16px;
  box-shadow:0 6px 16px rgba(37,99,235,.35)}
.auth-card h2{text-align:center;font-size:20px;font-weight:800;margin-bottom:4px}
.auth-card .sub{text-align:center;color:var(--text2);font-size:13px;margin-bottom:24px}
.auth-field{margin-bottom:14px}
.auth-field label{display:block;font-size:12.5px;font-weight:600;color:#334155;margin-bottom:5px}
.auth-field input{width:100%;padding:11px 13px;border:1px solid var(--border);border-radius:10px;
  font-size:14px;outline:none;transition:.15s}
.auth-field input:focus{border-color:var(--primary);box-shadow:0 0 0 3px rgba(37,99,235,.1)}
.auth-btn{width:100%;padding:12px;border-radius:10px;background:var(--primary);color:#fff;
  font-weight:700;font-size:14px;transition:.15s;margin-top:6px}
.auth-btn:hover{background:var(--primary-d)}
.auth-btn:disabled{opacity:.6;cursor:not-allowed}
.auth-toggle{text-align:center;margin-top:16px;font-size:13px;color:var(--text2)}
.auth-toggle a{color:var(--primary);font-weight:600;cursor:pointer;text-decoration:none}
.auth-toggle a:hover{text-decoration:underline}
.auth-msg{font-size:12.5px;text-align:center;margin-top:12px;padding:8px;border-radius:8px;display:none}
.auth-msg.error{display:block;background:var(--danger-bg);color:var(--danger)}
.auth-msg.success{display:block;background:var(--ok-bg);color:var(--ok)}

/* ===== 主应用 ===== */
.app{max-width:1440px;margin:0 auto;padding:0 20px 60px;display:none}
.app.ready{display:block}
.topbar{display:flex;align-items:center;justify-content:space-between;padding:20px 0 16px;flex-wrap:wrap;gap:12px}
.brand{display:flex;align-items:center;gap:12px}
.brand .logo{width:44px;height:44px;border-radius:12px;background:linear-gradient(135deg,#2563eb,#1d4ed8);
  display:flex;align-items:center;justify-content:center;font-size:22px;color:#fff;box-shadow:0 4px 12px rgba(37,99,235,.3)}
.brand h1{font-size:19px;font-weight:700;letter-spacing:-.3px}
.brand p{font-size:11px;color:var(--text2);letter-spacing:.5px;text-transform:uppercase}
.actions{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.user-chip{display:inline-flex;align-items:center;gap:6px;padding:6px 12px;background:#fff;
  border:1px solid var(--border);border-radius:999px;font-size:12px;color:var(--text2)}
.user-chip .dot{width:7px;height:7px;border-radius:50%;background:var(--ok)}

.btn{padding:9px 16px;border-radius:9px;background:var(--primary);color:#fff;font-weight:600;font-size:13px;
  transition:.15s;display:inline-flex;align-items:center;gap:6px;white-space:nowrap}
.btn:hover{background:var(--primary-d);transform:translateY(-1px)}
.btn.ghost{background:#fff;color:var(--text);border:1px solid var(--border)}
.btn.ghost:hover{background:#f8fafc;border-color:#cbd5e1}
.btn.sm{padding:5px 11px;font-size:12px;border-radius:7px}
.btn.danger{background:var(--danger)}
.btn.ok{background:var(--ok)}
.btn.amber{background:var(--warn)}

.tabs{display:flex;gap:4px;border-bottom:2px solid var(--border);margin-bottom:22px;overflow-x:auto}
.tab{padding:11px 18px;font-weight:600;color:var(--text2);border-bottom:2px solid transparent;
  margin-bottom:-2px;transition:.15s;white-space:nowrap;font-size:13.5px}
.tab.active{color:var(--primary);border-bottom-color:var(--primary)}
.panel{display:none}
.panel.active{display:block}

.card{background:var(--card);border:1px solid var(--border);border-radius:var(--radius);
  box-shadow:0 1px 3px rgba(15,23,42,.04);margin-bottom:18px;overflow:hidden}
.card-head{padding:15px 18px;border-bottom:1px solid var(--border);display:flex;
  align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}
.card-head h3{font-size:14.5px;font-weight:700}
.card-body{padding:18px}
.card-actions{display:flex;gap:10px;align-items:center;flex-wrap:wrap}

select,input[type=text],input[type=date],input[type=number],textarea{
  padding:7px 10px;border:1px solid var(--border);border-radius:8px;background:#fff;color:var(--text);
  outline:none;transition:.15s;font-size:13px}
select:focus,input:focus,textarea:focus{border-color:var(--primary);box-shadow:0 0 0 3px rgba(37,99,235,.1)}

.seg{display:inline-flex;background:#f1f5f9;border-radius:10px;padding:3px;gap:2px}
.seg-btn{padding:7px 13px;border-radius:8px;font-size:12.5px;font-weight:600;color:var(--text2);transition:.15s}
.seg-btn.active{background:#fff;color:var(--primary);box-shadow:0 1px 3px rgba(15,23,42,.12)}
.seg-btn .cnt{display:inline-block;background:#e2e8f0;color:#475569;border-radius:999px;
  padding:0 6px;font-size:10.5px;font-weight:700;min-width:18px;text-align:center}
.seg-btn.active .cnt{background:#dbeafe;color:#1d4ed8}

.filter-bar{display:flex;flex-wrap:wrap;gap:10px;padding:14px 18px;
  border-bottom:1px solid var(--border);background:#fcfdfe;align-items:flex-end}
.fi{display:flex;flex-direction:column;gap:4px}
.fi label{font-size:11px;color:var(--text2);font-weight:600}
.fi-search{flex:1;min-width:210px}
.fi-search input{width:100%}
.fi-date{width:130px}
.fi-reset{align-self:flex-end}

.bulk-bar{display:flex;align-items:center;gap:9px;padding:11px 18px;background:#eff6ff;
  border-bottom:1px solid #bfdbfe;flex-wrap:wrap}
.bulk-bar[hidden]{display:none}
.bulk-bar .info{font-size:12.5px;color:#1e40af;font-weight:600}
.bulk-bar .info b{font-size:16px;font-weight:800}
.bulk-sep{width:1px;height:20px;background:#bfdbfe}

.stat-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:14px;margin-bottom:20px}
.stat{background:#fff;border:1px solid var(--border);border-radius:var(--radius);padding:16px 18px;
  position:relative;overflow:hidden;box-shadow:0 1px 3px rgba(15,23,42,.04)}
.stat::before{content:'';position:absolute;left:0;top:0;bottom:0;width:4px;background:var(--primary)}
.stat.danger::before{background:var(--danger)}
.stat.warn::before{background:var(--warn)}
.stat.ok::before{background:var(--ok)}
.stat.gray::before{background:#94a3b8}
.stat-label{font-size:12.5px;color:var(--text2);font-weight:500}
.stat-value{font-size:26px;font-weight:800;letter-spacing:-1px;margin:4px 0 2px;font-variant-numeric:tabular-nums}
.stat-value small{font-size:13px;font-weight:600;color:var(--text2);margin-left:2px}
.stat-sub{font-size:12px;color:var(--text2)}

.table-wrap{overflow-x:auto}
table{width:100%;border-collapse:collapse;font-size:13px}
th{text-align:left;padding:11px 12px;font-weight:600;color:var(--text2);font-size:12px;
  background:#f8fafc;border-bottom:1px solid var(--border);white-space:nowrap;position:sticky;top:0;z-index:2}
td{padding:11px 12px;border-bottom:1px solid #f1f5f9;vertical-align:middle}
tbody tr:nth-child(odd){background:#fff}
tbody tr:nth-child(even){background:var(--stripe)}
tbody tr:hover{background:var(--hover)}
tbody tr.selected{background:var(--sel)!important;box-shadow:inset 3px 0 0 var(--primary)}
tbody tr.archived-row{opacity:.62}
tbody tr:last-child td{border-bottom:none}

.num{font-variant-numeric:tabular-nums;font-weight:600}
.mono{font-family:ui-monospace,Menlo,monospace;font-size:12px;color:var(--text2)}
.truncate{max-width:260px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.empty{padding:48px 20px;text-align:center;color:var(--text2)}
.empty .icon{font-size:40px;opacity:.35;display:block;margin-bottom:10px}

.badge{display:inline-flex;align-items:center;gap:4px;padding:2.5px 9px;border-radius:999px;
  font-size:11.5px;font-weight:600;white-space:nowrap}
.badge.blue{background:#eff6ff;color:#1d4ed8}
.badge.cyan{background:var(--info-bg);color:var(--info)}
.badge.purple{background:#f5f3ff;color:#7c3aed}
.badge.red{background:var(--danger-bg);color:var(--danger)}
.badge.amber{background:var(--warn-bg);color:var(--warn)}
.badge.green{background:var(--ok-bg);color:var(--ok)}
.badge.gray{background:#f1f5f9;color:#475569}
.badge.slate{background:#e2e8f0;color:#334155}

.alert-row{display:flex;align-items:center;gap:14px;padding:13px 18px;border-bottom:1px solid #f1f5f9;flex-wrap:wrap}
.alert-row:nth-child(even){background:var(--stripe)}
.alert-row:hover{background:var(--hover)}
.alert-row:last-child{border-bottom:none}
.alert-row .bar{width:4px;height:38px;border-radius:2px;flex-shrink:0}
.alert-main{flex:1;min-width:220px}
.alert-main .t{font-weight:600;font-size:13.5px}
.alert-main .s{font-size:12px;color:var(--text2);margin-top:1px}
.alert-meta{text-align:right;min-width:130px}
.alert-meta .amt{font-weight:800;font-size:15px;font-variant-numeric:tabular-nums}
.alert-meta .dt{font-size:11.5px;color:var(--text2)}

.overlay{position:fixed;inset:0;background:rgba(15,23,42,.5);backdrop-filter:blur(3px);
  display:none;align-items:center;justify-content:center;z-index:100;padding:20px}
.overlay.show{display:flex}
.modal{background:#fff;border-radius:16px;width:100%;max-width:680px;max-height:90vh;
  display:flex;flex-direction:column;box-shadow:0 24px 60px rgba(15,23,42,.3)}
.modal.wide{max-width:1000px}
.modal-head{padding:18px 22px;border-bottom:1px solid var(--border);display:flex;
  align-items:center;justify-content:space-between}
.modal-head h3{font-size:16px;font-weight:700}
.modal-head .close{font-size:26px;color:var(--text2);line-height:1;padding:0 4px;border-radius:6px}
.modal-head .close:hover{background:#f1f5f9}
.modal-body{padding:22px;overflow-y:auto;flex:1}
.modal-foot{padding:15px 22px;border-top:1px solid var(--border);display:flex;
  justify-content:flex-end;gap:10px;background:#f8fafc;border-radius:0 0 16px 16px}

.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:15px}
.field{display:flex;flex-direction:column;gap:5px}
.field.full{grid-column:1/-1}
.field label{font-size:12.5px;font-weight:600;color:#334155}
.field label .req{color:var(--danger)}
.field input,.field select,.field textarea{width:100%}
.field textarea{resize:vertical;min-height:64px}
.hint{font-size:11.5px;color:var(--text2)}
.hint.good{color:var(--primary)}

.tl{position:relative;padding-left:22px}
.tl::before{content:'';position:absolute;left:6px;top:8px;bottom:8px;width:2px;background:var(--border)}
.tl-item{position:relative;padding:9px 0 9px 12px}
.tl-item::before{content:'';position:absolute;left:-21px;top:15px;width:10px;height:10px;
  border-radius:50%;background:#cbd5e1;border:2px solid #fff;box-shadow:0 0 0 1px var(--border)}
.tl-item.paid::before{background:var(--ok)}
.tl-item.next::before{background:var(--primary);box-shadow:0 0 0 3px rgba(37,99,235,.18)}
.tl-item.overdue::before{background:var(--danger);box-shadow:0 0 0 3px rgba(220,38,38,.18)}
.tl-item .row{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;align-items:baseline}
.tl-item .y{font-weight:700;font-size:13px}
.tl-item .d{font-size:12px;color:var(--text2)}
.tl-item .f{font-weight:700;font-variant-numeric:tabular-nums}

.q-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:16px}
.q-card{border:1px solid var(--border);border-radius:12px;overflow:hidden;background:#fff}
.q-head{padding:12px 16px;background:#f8fafc;border-bottom:1px solid var(--border);
  display:flex;justify-content:space-between;align-items:center}
.q-head .name{font-weight:700;font-size:14px}
.q-head .amt{font-weight:800;color:var(--primary);font-variant-numeric:tabular-nums}
.q-list{max-height:320px;overflow-y:auto}
.q-item{padding:8px 16px;display:flex;justify-content:space-between;gap:10px;
  font-size:12.5px;border-bottom:1px solid #f8fafc}
.q-item:nth-child(even){background:var(--stripe)}
.q-item .n{flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#334155}
.q-item .v{font-weight:600;font-variant-numeric:tabular-nums;white-space:nowrap}

.rules{font-size:13px;line-height:1.9;color:#334155}
.rules h4{font-size:13.5px;font-weight:700;margin:14px 0 6px}
.rules h4:first-child{margin-top:0}
.rules ul{padding-left:20px}
.rules code{background:#f1f5f9;padding:1px 6px;border-radius:5px;font-size:12px;font-family:monospace}
.rules .note{background:var(--warn-bg);border-left:3px solid var(--warn);padding:10px 14px;
  border-radius:0 8px 8px 0;margin:10px 0;font-size:12.5px}

@media(max-width:720px){
  .form-grid{grid-template-columns:1fr}
  .alert-meta{text-align:left}
  .fi-search{min-width:100%}
}
</style>
</head>
<body>

<!-- ========== 登录界面 ========== -->
<div id="authScreen">
  <div class="auth-card">
    <div class="logo">⚖</div>
    <h2>专利年费管理系统</h2>
    <p class="sub" id="authSub">请登录以继续</p>

    <div class="auth-field">
      <label>邮箱</label>
      <input type="email" id="authEmail" placeholder="your@email.com" autocomplete="email">
    </div>
    <div class="auth-field">
      <label>密码</label>
      <input type="password" id="authPassword" placeholder="至少 6 位" autocomplete="current-password">
    </div>

    <button class="auth-btn" id="authSubmit">登录</button>

    <div class="auth-msg" id="authMsg"></div>

    <div class="auth-toggle">
      <span id="authToggleText">还没有账户？</span>
      <a id="authToggleLink">立即注册</a>
    </div>
  </div>
</div>

<!-- ========== 主应用 ========== -->
<div class="app" id="app">
  <header class="topbar">
    <div class="brand">
      <div class="logo">⚖</div>
      <div>
        <h1>专利年费管理系统</h1>
        <p>Patent Annuity Manager</p>
      </div>
    </div>
    <div class="actions">
      <span class="user-chip"><span class="dot"></span><span id="userEmail"></span></span>
      <button class="btn" id="btnAdd">＋ 新增专利</button>
      <button class="btn ghost" id="btnExportAll">导出数据</button>
      <button class="btn ghost" id="btnImport">导入数据</button>
      <button class="btn ghost" id="btnLogout">退出</button>
      <input type="file" id="fileInput" accept=".json" hidden>
    </div>
  </header>

  <nav class="tabs">
    <button class="tab active" data-tab="dashboard">📊 看板</button>
    <button class="tab" data-tab="ledger">📋 专利台账</button>
    <button class="tab" data-tab="schedule">📅 缴费计划</button>
    <button class="tab" data-tab="report">📈 周期报表</button>
    <button class="tab" data-tab="settings">⚙️ 规则说明</button>
  </nav>

  <section class="panel active" id="panel-dashboard">
    <div class="stat-grid" id="statGrid"></div>
    <div class="card">
      <div class="card-head">
        <h3>⏰ 缴费提醒</h3>
        <div class="card-actions">
          <label>范围
            <select id="alertHorizon">
              <option value="30">未来 30 天</option>
              <option value="60">未来 60 天</option>
              <option value="90" selected>未来 90 天</option>
              <option value="180">未来 180 天</option>
              <option value="99999">全部未缴</option>
            </select>
          </label>
        </div>
      </div>
      <div id="alertList"></div>
    </div>
  </section>

  <section class="panel" id="panel-ledger">
    <div class="card">
      <div class="card-head">
        <h3>📋 专利台账</h3>
        <div class="seg" id="ledgerScope">
          <button class="seg-btn active" data-scope="active">监控中 <span class="cnt" id="cntActive">0</span></button>
          <button class="seg-btn" data-scope="archived">已归档 <span class="cnt" id="cntArchived">0</span></button>
          <button class="seg-btn" data-scope="all">全部 <span class="cnt" id="cntAll">0</span></button>
        </div>
      </div>

      <div class="filter-bar">
        <div class="fi fi-search">
          <label>关键词</label>
          <input type="text" id="ledgerSearch" placeholder="🔍 名称 / 申请号 / 客户 / 联系人…">
        </div>
        <div class="fi">
          <label>客户</label>
          <select id="ledgerClient"><option value="">全部</option></select>
        </div>
        <div class="fi">
          <label>类型</label>
          <select id="ledgerType">
            <option value="">全部</option>
            <option>发明</option><option>实用新型</option><option>外观设计</option>
          </select>
        </div>
        <div class="fi">
          <label>减免</label>
          <select id="ledgerReduction">
            <option value="">全部</option>
            <option value="0">不减缴</option>
            <option value="70">减缴 70%</option>
            <option value="85">减缴 85%</option>
          </select>
        </div>
        <div class="fi">
          <label>状态</label>
          <select id="ledgerStatus">
            <option value="">全部</option>
            <option>有效</option><option>申请中</option><option>放弃</option><option>终止</option>
          </select>
        </div>
        <div class="fi">
          <label>紧急度</label>
          <select id="ledgerUrgency">
            <option value="">全部</option>
            <option value="overdue">已逾期</option>
            <option value="30">30 天内</option>
            <option value="90">90 天内</option>
            <option value="none">无待缴</option>
          </select>
        </div>
        <div class="fi fi-date">
          <label>申请日 ≥</label>
          <input type="date" id="ledgerAppFrom">
        </div>
        <div class="fi fi-date">
          <label>申请日 ≤</label>
          <input type="date" id="ledgerAppTo">
        </div>
        <div class="fi fi-reset">
          <label>&nbsp;</label>
          <button class="btn ghost sm" id="btnResetFilters">重置</button>
        </div>
      </div>

      <div class="bulk-bar" id="bulkBar" hidden>
        <span class="info">已选中 <b id="selCount">0</b> 件</span>
        <span class="bulk-sep"></span>
        <button class="btn sm amber" id="bulkArchive">📦 归档</button>
        <button class="btn sm ok" id="bulkRestore">↩ 恢复</button>
        <span class="bulk-sep"></span>
        <select id="bulkStatusSel" style="padding:5px 9px;font-size:12px">
          <option value="有效">有效</option>
          <option value="申请中">申请中</option>
          <option value="放弃">放弃</option>
          <option value="终止">终止</option>
        </select>
        <button class="btn sm ghost" id="bulkSetStatus">批量改状态</button>
        <span class="bulk-sep"></span>
        <button class="btn sm ghost" id="bulkExport">导出选中</button>
        <button class="btn sm ghost" id="bulkClear">取消</button>
      </div>

      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th style="width:36px"><input type="checkbox" id="checkAll"></th>
              <th style="width:40px">#</th>
              <th>专利名称</th>
              <th>申请号</th>
              <th>类型</th>
              <th>客户</th>
              <th>申请日</th>
              <th>授权日</th>
              <th>减免</th>
              <th>当前年度</th>
              <th>下次截止</th>
              <th>应缴</th>
              <th>状态</th>
              <th style="width:120px">操作</th>
            </tr>
          </thead>

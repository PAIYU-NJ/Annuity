const SUPABASE_ANON_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InZxYndkcmZpb3hsYWF4YWVxdHhoIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTAyMTQ0NDgsImV4cCI6MjEwNTc5MDQ0OH0.JHs2kqc3ydkaT0SFhzxONKM8LcnsNQ2P45zALIihQhY';


async function savePatent(){
  const name=document.getElementById('f_name').value.trim();
  const appNo=document.getElementById('f_appNo').value.trim();
  const appDate=document.getElementById('f_appDate').value;
  const client=document.getElementById('f_client').value.trim();
  if(!name) return alert('请填写专利名称');
  if(!appNo) return alert('请填写申请号');
  if(!appDate) return alert('请填写申请日');
  if(!client) return alert('请填写客户');

  const archived=document.getElementById('f_archived').value==='1';
  const data={
    id: editingId || ('P'+Date.now()+Math.random().toString(36).slice(2,7)),
    name, appNo, appDate,
    type:document.getElementById('f_type').value,
    grantDate:document.getElementById('f_grantDate').value||'',
    client,
    reduction:Number(document.getElementById('f_reduction').value)||0,
    status:document.getElementById('f_status').value,
    archived, archivedAt: archived?fmtDate(new Date()):'',
    contact:document.getElementById('f_contact').value.trim(),
    phone:document.getElementById('f_phone').value.trim(),
    notes:document.getElementById('f_notes').value.trim(),
    paidYears: editingId ? (state.patents.find(x=>x.id===editingId).paidYears||[]) : []
  };
  const ok=await upsertPatent(data);
  if(!ok) return;
  document.getElementById('modalPatent').classList.remove('show');
  await loadPatents(); renderAll();
}
async function deletePatent(id){
  const p=state.patents.find(x=>x.id===id); if(!p) return;
  if(!confirm(`确定永久删除「${p.name}」？建议改用归档以保留记录。`)) return;
  if(!await deletePatentById(id)) return;
  state.patents=state.patents.filter(x=>x.id!==id);
  document.getElementById('modalDetail').classList.remove('show');
  renderAll();
}
function openDetail(id){
  const p=state.patents.find(x=>x.id===id); if(!p) return;
  const today=startOfDay(new Date());
  const schedule=buildSchedule(p);
  const next=getNextDue(p,today);
  const nextYear=next?next.year:-1;
  document.getElementById('detailTitle').textContent=p.name;

  const info=`<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:14px;margin-bottom:18px">
    ${[['申请号',p.appNo],['类型',p.type],['申请日',p.appDate],['授权日',p.grantDate||'未授权'],
       ['客户',p.client],['费减',p.reduction>0?'减缴 '+p.reduction+'%':'不减缴'],
       ['当前年度',p.grantDate?'第 '+yearOf(parseDate(p.appDate),today)+' 年度':'—'],
       ['状态',p.status||'有效'],['监控',p.archived?'已归档':'监控中'],
       ['联系人',(p.contact||'—')+(p.phone?' / '+p.phone:'')]
      ].map(([k,v])=>`<div><div style="font-size:11.5px;color:var(--text2);font-weight:600">${k}</div>
        <div style="font-weight:600;margin-top:2px">${esc(v)}</div></div>`).join('')}</div>
    ${p.notes?`<div style="background:#f8fafc;padding:12px 14px;border-radius:8px;font-size:12.5px;margin-bottom:20px"><b>备注：</b>${esc(p.notes)}</div>`:''}
    <h4 style="font-size:13.5px;margin-bottom:6px">年费时间轴</h4>
    <div style="font-size:12px;color:var(--text2);margin-bottom:12px">申请日 ${p.appDate} · 缴费截止 = 申请日对应日</div>`;

  const timeline=schedule.length?`<div class="tl">${schedule.map(it=>{
    const paid=isPaid(p,it); const isNext=it.year===nextYear;
    const due=parseDate(it.dueDate); const late=!paid&&due&&today>due?calcLate(it.dueDate,it.fee,today):null;
    let cls=paid?'paid':(isNext?(late&&late.months>0?'overdue':'next'):'');
    let tag=paid?'<span class="badge green">已缴</span>':isNext?
      (late&&late.months>0?`<span class="badge red">逾期 ${late.months} 月</span>`:'<span class="badge blue">待缴</span>')
      :'<span class="badge gray">—</span>';
    const feeTxt=it.reduction>0?`¥${money(it.fee)} <span style="font-size:11px;color:var(--text2)">(标价 ¥${money(it.baseFee)}，减 ${it.reduction}%)</span>`:`¥${money(it.fee)}`;
    return `<div class="tl-item ${cls}"><div class="row">
      <div><div class="y">第 ${it.year} 年度 ${it.isGrantYear?'<span class="badge blue" style="font-size:10px">授权当年</span>':''}</div>
      <div class="d">${it.startDate} ~ ${it.endDate} · 截止 ${it.dueDate}</div></div>
      <div style="text-align:right"><div class="f">${feeTxt}</div><div style="margin-top:3px">${tag}</div></div></div>
      <div style="margin-top:6px">${paid?`<button class="btn sm ghost" data-dunpay="${it.year}">撤销已缴</button>`
        :`<button class="btn sm ok" data-dpay="${it.year}">标记已缴</button>`}</div></div>`;
  }).join('')}</div>`:'<div class="empty">尚未授权，暂不产生年费</div>';

  document.getElementById('detailBody').innerHTML=info+timeline+`
    <div style="margin-top:24px;display:flex;gap:10px;flex-wrap:wrap">

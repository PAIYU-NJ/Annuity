const DAY_MS = 86400000;
const FEE_TABLE = {
  '发明':     [[1,3,900],[4,6,1200],[7,9,2000],[10,12,4000],[13,15,6000],[16,20,8000]],
  '实用新型': [[1,3,600],[4,5,900],[6,8,1200],[9,10,2000]],
  '外观设计': [[1,3,600],[4,5,900],[6,8,1200],[9,10,2000],[11,15,3000]]
};
const TYPE_BADGE = { '发明':'blue', '实用新型':'cyan', '外观设计':'purple' };

function parseDate(s){
  if(!s) return null;
  if(s instanceof Date) return new Date(s.getFullYear(), s.getMonth(), s.getDate());
  const m = String(s).match(/(\d{4})\D(\d{1,2})\D(\d{1,2})/);
  if(!m) return null;
  const d = new Date(+m[1], +m[2]-1, +m[3]);
  return isNaN(d.getTime()) ? null : d;
}
function fmtDate(d){
  if(!d) return '';
  return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');
}
function addDays(d,n){ const r=new Date(d.getTime()); r.setDate(r.getDate()+n); return r; }
function addMonths(d,n){
  const r=new Date(d.getTime()); const day=r.getDate();
  r.setDate(1); r.setMonth(r.getMonth()+n);
  const last=new Date(r.getFullYear(),r.getMonth()+1,0).getDate();
  r.setDate(Math.min(day,last)); return r;
}
function addYears(d,n){
  const r=new Date(d.getTime()); const day=r.getDate(),mon=r.getMonth();
  r.setDate(1); r.setFullYear(r.getFullYear()+n); r.setMonth(mon);
  const last=new Date(r.getFullYear(),mon+1,0).getDate();
  r.setDate(Math.min(day,last)); return r;
}
function startOfDay(d){ return new Date(d.getFullYear(),d.getMonth(),d.getDate()); }
function daysBetween(a,b){ return Math.round((startOfDay(b)-startOfDay(a))/DAY_MS); }
function money(n){ return (n||0).toLocaleString('zh-CN'); }
function esc(s){
  return String(s==null?'':s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}

/* =========================================================
   2. 年费计算
   ========================================================= */
function getBaseFee(type,year){
  const rows=FEE_TABLE[type]; if(!rows) return null;
  for(const [a,b,f] of rows) if(year>=a&&year<=b) return f;
  return null;
}
function maxYear(type){ const r=FEE_TABLE[type]; return r?r[r.length-1][1]:20; }
function yearOf(appDate,date){
  if(date<appDate) return 0;
  let n=1; while(addYears(appDate,n)<=date) n++;
  return n;
}
function buildSchedule(p){
  const appDate=parseDate(p.appDate); if(!appDate) return [];
  const grantDate=p.grantDate?parseDate(p.grantDate):null;
  const grantYear=grantDate?yearOf(appDate,grantDate):null;
  const reduction=Number(p.reduction)||0;
  const max=maxYear(p.type);
  const out=[];
  for(let n=1;n<=max;n++){
    const base=getBaseFee(p.type,n); if(base==null) continue;
    const start=addYears(appDate,n-1);
    const end=addDays(addYears(appDate,n),-1);
    let applyRed=0;
    if(grantYear!=null&&reduction>0&&n>=grantYear&&n<=grantYear+9) applyRed=reduction;
    const fee=Math.round(base*(1-applyRed/100));
    let phase,dueDate;
    if(grantYear==null){ phase='pending-grant'; dueDate=start; }
    else if(n<=grantYear){ phase='grant-registration'; dueDate=grantDate; }
    else { phase='annuity'; dueDate=start; }
    out.push({
      year:n, startDate:fmtDate(start), endDate:fmtDate(end), dueDate:fmtDate(dueDate),
      baseFee:base, reduction:applyRed, fee, phase, isGrantYear:n===grantYear
    });
  }
  return out;
}
function isPaid(p,item){
  if((p.paidYears||[]).indexOf(item.year)>=0) return true;
  if(item.phase==='grant-registration') return true;
  return false;
}
function calcLate(dueDateStr,fee,asOf){
  const due=parseDate(dueDateStr);
  if(!due||asOf<=due) return {months:0,rate:0,amount:0,terminated:false};
  let m=0; while(m<24&&addMonths(due,m+1)<asOf) m++;
  const terminated=m>=6;
  const rate=m===0?0:Math.min(m,5)*0.05;
  return {months:m,rate,amount:Math.round(fee*rate),terminated};
}
function getUnpaidItems(p,asOf){
  const out=[];
  if(p.status==='放弃'||p.status==='终止') return out;
  for(const item of buildSchedule(p)){
    if(item.phase==='pending-grant') continue;
    if(isPaid(p,item)) continue;
    const due=parseDate(item.dueDate);
    const daysLeft=daysBetween(asOf,due);
    const late=calcLate(item.dueDate,item.fee,asOf);
    out.push(Object.assign({},item,{
      patent:p, daysLeft, lateMonths:late.months, lateFee:late.amount,
      terminated:late.terminated, total:item.fee+late.amount
    }));
  }
  return out;
}
function getNextDue(p,asOf){
  const list=getUnpaidItems(p,asOf);
  return list.length?list[0]:null;
}
function statusMeta(it){
  if(it.terminated) return {cls:'red',label:'⚠ 可能已终止'};
  if(it.daysLeft<0) return {cls:'red',label:'已逾期 '+(-it.daysLeft)+' 天'};
  if(it.daysLeft===0) return {cls:'red',label:'今日到期'};
  if(it.daysLeft<=30) return {cls:'amber',label:'剩余 '+it.daysLeft+' 天'};
  if(it.daysLeft<=90) return {cls:'cyan',label:'剩余 '+it.daysLeft+' 天'};
  return {cls:'gray',label:'剩余 '+it.daysLeft+' 天'};
}

      ${p.archived?`<button class="btn ok" id="btnRestoreFromDetail">↩ 恢复监控</button>`
        :`<button class="btn amber" id="btnArchiveFromDetail">📦 归档</button>`}
      <button class="btn danger" id="btnDeletePatent">删除</button></div>`;

  const body=document.getElementById('detailBody');
  body.querySelectorAll('[data-dpay]').forEach(b=>b.addEventListener('click',()=>{ markPaid(p.id,Number(b.dataset.dpay)).then(()=>openDetail(p.id)); }));
  body.querySelectorAll('[data-dunpay]').forEach(b=>b.addEventListener('click',()=>{ unmarkPaid(p.id,Number(b.dataset.dunpay)).then(()=>openDetail(p.id)); }));
  document.getElementById('btnEditFromDetail').addEventListener('click',()=>{
    document.getElementById('modalDetail').classList.remove('show'); openPatentModal(p.id);
  });
  const ba=document.getElementById('btnArchiveFromDetail');
  if(ba) ba.addEventListener('click',async()=>{
    await updatePatentField(p.id,{archived:true,archived_at:fmtDate(new Date())});
    p.archived=true; p.archivedAt=fmtDate(new Date()); renderAll(); openDetail(p.id);
  });
  const br=document.getElementById('btnRestoreFromDetail');
  if(br) br.addEventListener('click',async()=>{
    await updatePatentField(p.id,{archived:false,archived_at:''});
    p.archived=false; p.archivedAt=''; renderAll(); openDetail(p.id);
  });
  document.getElementById('btnDeletePatent').addEventListener('click',()=>deletePatent(p.id));
  document.getElementById('modalDetail').classList.add('show');
}


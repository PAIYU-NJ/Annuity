/* =========================================================
   8. 台账
   ========================================================= */
function filterPatents(){
  const q=document.getElementById('ledgerSearch').value.trim().toLowerCase();
  const fClient=document.getElementById('ledgerClient').value;
  const fType=document.getElementById('ledgerType').value;
  const fRed=document.getElementById('ledgerReduction').value;
  const fStatus=document.getElementById('ledgerStatus').value;
  const fUrg=document.getElementById('ledgerUrgency').value;
  const fFrom=document.getElementById('ledgerAppFrom').value;
  const fTo=document.getElementById('ledgerAppTo').value;
  const today=startOfDay(new Date());

  let rows=state.patents.filter(p=>{
    if(ledgerScope==='active'&&p.archived) return false;
    if(ledgerScope==='archived'&&!p.archived) return false;
    return true;
  });
  if(q) rows=rows.filter(p=>(p.name||'').toLowerCase().includes(q)||
    (p.appNo||'').toLowerCase().includes(q)||(p.client||'').toLowerCase().includes(q)||
    (p.contact||'').toLowerCase().includes(q));
  if(fClient) rows=rows.filter(p=>p.client===fClient);
  if(fType) rows=rows.filter(p=>p.type===fType);
  if(fRed!=='') rows=rows.filter(p=>String(p.reduction||0)===fRed);
  if(fStatus) rows=rows.filter(p=>(p.status||'有效')===fStatus);
  if(fFrom) rows=rows.filter(p=>p.appDate&&p.appDate>=fFrom);
  if(fTo) rows=rows.filter(p=>p.appDate&&p.appDate<=fTo);

  let out=rows.map(p=>{
    const appDate=parseDate(p.appDate);
    const curYear=appDate?yearOf(appDate,today):0;
    const next=getNextDue(p,today);
    return {p,curYear,next};
  });
  if(fUrg==='overdue') out=out.filter(r=>r.next&&r.next.daysLeft<0);
  else if(fUrg==='30') out=out.filter(r=>r.next&&r.next.daysLeft>=0&&r.next.daysLeft<=30);
  else if(fUrg==='90') out=out.filter(r=>r.next&&r.next.daysLeft>=0&&r.next.daysLeft<=90);
  else if(fUrg==='none') out=out.filter(r=>!r.next);

  out.sort((a,b)=>{
    if(!!a.p.archived!==!!b.p.archived) return a.p.archived?1:-1;
    return (a.next?a.next.daysLeft:99999)-(b.next?b.next.daysLeft:99999);
  });
  return out;
}


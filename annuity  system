      <div class="stat-sub">含 30 天内 ${within30.length} 笔 · ¥${money(amt(within90))}</div></div>
    <div class="stat danger"><div class="stat-label">已逾期</div>
      <div class="stat-value">${overdue.length}<small>笔</small></div>
      <div class="stat-sub">¥${money(amt(overdue))}</div></div>
    <div class="stat gray"><div class="stat-label">已归档</div>
      <div class="stat-value">${archived}<small>件</small></div>
      <div class="stat-sub">记录保留，不参与提醒</div></div>`;

  const horizon=Number(state.settings.alertHorizon)||90;
  const alertList=all.filter(it=>it.daysLeft<0||it.daysLeft<=horizon)
    .sort((a,b)=>a.daysLeft-b.daysLeft);
  const box=document.getElementById('alertList');
  if(!alertList.length){
    box.innerHTML='<div class="empty"><span class="icon">✅</span>该范围内暂无待缴年费</div>';

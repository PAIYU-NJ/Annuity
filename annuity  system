function renderReport(){
  const yearSel=document.getElementById('reportYear');
  const today=startOfDay(new Date());
  const years=new Set([today.getFullYear(),today.getFullYear()+1,today.getFullYear()+2]);
  state.patents.forEach(p=>{ const a=parseDate(p.appDate); if(a) for(let y=a.getFullYear();y<=today.getFullYear()+3;y++) years.add(y); });
  const sorted=Array.from(years).sort();
  const cur=yearSel.value||String(today.getFullYear());
  yearSel.innerHTML=sorted.map(y=>`<option value="${y}"${String(y)===cur?' selected':''}>${y} 年</option>`).join('');

  const year=Number(yearSel.value||today.getFullYear());
  const fClient=document.getElementById('reportClient').value;
  let items=[]; monitored().forEach(p=>{ items=items.concat(getUnpaidItems(p,today)); });
  if(fClient) items=items.filter(it=>it.patent.client===fClient);
  items=items.filter(it=>{ const d=parseDate(it.dueDate); return d&&d.getFullYear()===year; });

  const qs=[{name:'第一季度',m:[0,1,2]},{name:'第二季度',m:[3,4,5]},{name:'第三季度',m:[6,7,8]},{name:'第四季度',m:[9,10,11]}];
  const total=items.reduce((s,it)=>s+it.total,0);
  document.getElementById('reportGrid').innerHTML=qs.map((q,qi)=>{
    const qiItems=items.filter(it=>{ const d=parseDate(it.dueDate); return q.m.indexOf(d.getMonth())>=0; })
      .sort((a,b)=>parseDate(a.dueDate)-parseDate(b.dueDate));
    const sum=qiItems.reduce((s,it)=>s+it.total,0);
    const list=qiItems.length?qiItems.map(it=>`<div class="q-item">
      <span class="n" title="${esc(it.patent.name)}">${it.dueDate.slice(5)} · ${esc(it.patent.client)} · ${esc(it.patent.name)}</span>
      <span class="v">¥${money(it.total)}</span></div>`).join('')
      :'<div style="padding:22px;text-align:center;color:var(--text2);font-size:12.5px">本季度无需缴纳</div>';
    return `<div class="q-card"><div class="q-head">
      <span class="name">${q.name} <span style="color:var(--text2);font-weight:400;font-size:12px">(${year}.${qi*3+1}–${qi*3+3})</span></span>
      <span class="amt">¥${money(sum)}</span></div><div class="q-list">${list}</div></div>`;
  }).join('')+`<div class="q-card" style="grid-column:1/-1;background:#f8fafc">
    <div class="q-head" style="background:#eff6ff"><span class="name">${year} 年度合计</span>
    <span class="amt" style="font-size:18px">¥${money(total)}</span></div>
    <div style="padding:14px 16px;color:var(--text2);font-size:12.5px">共 ${items.length} 笔 · 涉及 ${new Set(items.map(i=>i.patent.client)).size} 家客户</div></div>`;
}


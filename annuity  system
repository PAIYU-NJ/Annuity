function renderDashboard(){
  const today=startOfDay(new Date());
  const list=monitored();
  let all=[]; list.forEach(p=>{ all=all.concat(getUnpaidItems(p,today)); });
  const overdue=all.filter(it=>it.daysLeft<0);
  const within90=all.filter(it=>it.daysLeft>=0&&it.daysLeft<=90);
  const within30=all.filter(it=>it.daysLeft>=0&&it.daysLeft<=30);
  const archived=state.patents.length-list.length;
  const amt=arr=>arr.reduce((s,it)=>s+it.total,0);

  document.getElementById('statGrid').innerHTML=`
    <div class="stat"><div class="stat-label">监控中专利</div>
      <div class="stat-value">${list.length}<small>件</small></div>
      <div class="stat-sub">客户 ${new Set(list.map(p=>p.client)).size} 家 · 已归档 ${archived} 件</div></div>
    <div class="stat warn"><div class="stat-label">90 天内到期</div>
